{
  "name": "mafia-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop modding workbench for Mafia (2002)",
  "type": "module",
  "main": "src/desktop/main.js",
  "license": "MIT",
  "scripts": {
    "start": "npm run build && electron .",
    "build": "node tools/build.js",
    "setup:face": "node tools/prepare-face.js",
    "test": "node --test test/*.test.js",
    "check": "node tools/check.js",
    "extract": "node tools/extract.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "iconv-lite": "0.7.3",
    "polygon-clipping": "0.15.7",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "esbuild": "^0.25.12"
  }
}
